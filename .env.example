# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# WooCommerce (Optional - for transactional features)
WOOCOMMERCE_URL=your_woocommerce_url
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret

# Goyzer API (Optional - for listings sync)
GOYZER_API_URL=your_goyzer_api_url
GOYZER_API_KEY=your_goyzer_api_key

# RetellAI (Optional - for voice chat)
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_agent_id

# OpenAI (For embeddings/RAG)
OPENAI_API_KEY=your_openai_api_key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id